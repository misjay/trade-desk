# ─── Bybit V5 API ─────────────────────────────────────────────
# Live keys (real account)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here

# Testnet keys (demo / testnet account)
BYBIT_TESTNET_API_KEY=your_testnet_api_key_here
BYBIT_TESTNET_API_SECRET=your_testnet_secret_key_here

# ─── Mode ───────────────────────────────────────────────────
# demo  → paper trades, no real orders
# live  → real orders on Bybit (requires live keys above)
TRADE_MODE=demo

# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Risk ───────────────────────────────────────────────────
# Fraction of equity risked per trade (0.005 = 0.5%, 0.01 = 1%)
RISK_PER_TRADE=0.005

# Starting paper equity for demo mode (USDT)
PAPER_EQUITY=10000

# ─── Scanner ────────────────────────────────────────────────
# Scalp timeframe (minutes)
SCALP_TF=15
# Day timeframe (hours)
DAY_TF=4
# Scan interval for scalp (seconds)
SCAN_INTERVAL_SCALP=300
# Scan interval for day (seconds)
SCAN_INTERVAL_DAY=1800

# ─── Desk hour for hourly summary push ──────────────────────
# Send full desk card every N minutes (0 = disable)
DESK_SUMMARY_INTERVAL=60

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
